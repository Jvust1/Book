{"chunk_id":"chunk_003b","parent_storage_chunk":"chunk_003","pdf_pages":[51,60],"printed_pages":[32,41],"status":"structured_v0.3_translation_learning_layer","chapter_id":"chapter_01","chapter_title_en":"Lp Spaces and Banach Spaces","chapter_title_zh":"L^p 空间与巴拿赫空间","sections":[{"id":"ch01_s07_01","number":"7.1","title_en":"The case of positive linear functionals","title_zh":"正线性泛函的情形","pdf_pages":[48,51],"printed_pages":[29,32],"batch_coverage":[51,51],"continued_from":"chunk_003a"},{"id":"ch01_s07_02","number":"7.2","title_en":"The main result","title_zh":"主要结果","pdf_pages":[51,52],"printed_pages":[32,33]},{"id":"ch01_s07_03","number":"7.3","title_en":"An extension","title_zh":"一个推广","pdf_pages":[52,53],"printed_pages":[33,34]},{"id":"ch01_s08","number":"8","title_en":"Exercises","title_zh":"练习","pdf_pages":[53,62],"printed_pages":[34,43],"batch_coverage":[53,60],"continues_in":"chunk_004a"}],"key_objects":[{"type":"proposition","id":"prop_7_2_jordan_functional_decomp","number":"7.2","name_en":"Decomposition of a bounded linear functional into positive parts","name_zh":"有界线性泛函分解为两个正线性泛函之差","anchor":{"pdf_page":51,"printed_page":32},"core_statement_zh":"对紧致度量空间 X，任意 C(X) 上有界线性泛函 ℓ 都可写成 ℓ=ℓ⁺−ℓ⁻，其中 ℓ⁺、ℓ⁻ 为正线性泛函，并且 ||ℓ||=ℓ⁺(1)+ℓ⁻(1)。"},{"type":"definition","id":"def_positive_part_functional","name_en":"Positive part of a bounded linear functional","name_zh":"有界线性泛函的正部 ℓ⁺","anchor":{"pdf_page":51,"printed_page":32},"formula":"ℓ⁺(f)=sup{ℓ(φ): 0≤φ≤f}, f≥0"},{"type":"theorem","id":"thm_7_3_riesz_representation_cx","number":"7.3","name_en":"Riesz representation for C(X)*","name_zh":"C(X) 对偶的 Riesz 表示定理","anchor":{"pdf_page":52,"printed_page":33},"core_statement_zh":"若 X 为紧致度量空间，则每个 C(X) 上有界线性泛函都唯一表示为对某个有限符号 Borel 测度 μ 的积分 ℓ(f)=∫_X f dμ，且 ||ℓ||=|μ|(X)。因此 C(X)* 与 M(X) 等距同构。","formula":"ℓ(f)=∫_X f dμ; ||ℓ||=||μ||=|μ|(X)"},{"type":"definition","id":"def_cb_x","name_en":"Cb(X)","name_zh":"有界连续函数空间 C_b(X)","anchor":{"pdf_page":52,"printed_page":33},"formula":"||f||=sup_{x∈X}|f(x)|"},{"type":"definition","id":"def_tightness_condition_21","name_en":"Tightness condition (21)","name_zh":"紧性（tightness）条件 (21)","anchor":{"pdf_page":52,"printed_page":33},"formula":"|ℓ(f)|≤sup_{x∈K_ε}|f(x)|+ε||f||","notes_zh":"对每个 ε>0，存在紧集 K_ε，使该估计对所有 f∈C_b(X) 成立。"},{"type":"theorem","id":"thm_7_4_noncompact_riesz_positive","number":"7.4","name_en":"Extension of positive representation to noncompact metric spaces","name_zh":"非紧度量空间上正线性泛函的表示推广","anchor":{"pdf_page":52,"printed_page":33},"core_statement_zh":"若 X 为度量空间，ℓ 是 C_b(X) 上归一化正线性泛函，并满足紧性条件 (21)，则存在唯一有限正 Borel 测度 μ，使 ℓ(f)=∫_X f dμ。"},{"type":"concept","id":"concept_tight_measure_compact_approximation","name_en":"Tight finite measure and compact approximation","name_zh":"有限测度的紧集逼近","anchor":{"pdf_page":53,"printed_page":34},"notes_zh":"当 X 完备且可分时，有限正 Borel 测度可由紧集从内部逼近，从而条件 (21) 对积分型正线性泛函是必要的。"}],"exercises":[{"id":"ch01_ex_01","number":1,"anchor":{"pdf_page":53,"printed_page":34},"summary_zh":"幂函数在原点/无穷远的 L^p 可积性与临界对数修正","topics":["Lp integrability","power singularity"]},{"id":"ch01_ex_02","number":2,"anchor":{"pdf_page":53,"printed_page":34},"summary_zh":"0<p<1 时三角不等式失败，以及 L^p(R) 不存在非零有界线性泛函","topics":["quasi-norm","bounded linear functional"]},{"id":"ch01_ex_03","number":3,"anchor":{"pdf_page":54,"printed_page":35},"summary_zh":"Hölder 不等式取等号的充要条件","topics":["Holder equality"]},{"id":"ch01_ex_04","number":4,"anchor":{"pdf_page":54,"printed_page":35},"summary_zh":"0<p<1 的反向型 Hölder/三角性质，并构造 d(f,g)=||f-g||_p^p 度量","topics":["p<1","metric"]},{"id":"ch01_ex_05","number":5,"anchor":{"pdf_page":54,"printed_page":35},"summary_zh":"L^p 范数收敛蕴含存在几乎处处收敛子列","topics":["subsequence","a.e. convergence"]},{"id":"ch01_ex_06","number":6,"anchor":{"pdf_page":54,"printed_page":35},"summary_zh":"简单函数在 L^∞（有限测度）与 L^p（p<∞）中的稠密性","topics":["simple functions","density"]},{"id":"ch01_ex_07","number":7,"anchor":{"pdf_page":54,"printed_page":35},"summary_zh":"C_c 与 C_c^∞ 在 L^p(R^d) 中的稠密性","topics":["density","smooth compact support"]},{